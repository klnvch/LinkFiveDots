<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="viewState"
            type="by.klnvch.link5dots.ui.game.picker.PickerViewState" />

        <variable
            name="visibilityViewState"
            type="by.klnvch.link5dots.ui.game.picker.states.VisibilityViewState" />

        <variable
            name="listener"
            type="by.klnvch.link5dots.ui.game.picker.listeners.OnPickerClickListener" />

        <variable
            name="visibilityListener"
            type="by.klnvch.link5dots.ui.game.picker.listeners.OnVisibilityClickListener" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/paper_tiled"
        android:keepScreenOn="true"
        android:padding="32dp">

        <Button
            android:id="@+id/buttonCreate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:enabled="@{viewState.isCreateOrDeleteButtonEnabled}"
            android:onClick="@{() -> listener.onCreateButtonClicked()}"
            android:text="@string/create"
            android:visibility="@{viewState.createButtonVisibility}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="320dp" />

        <Button
            android:id="@+id/buttonDelete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:enabled="@{viewState.isCreateOrDeleteButtonEnabled}"
            android:onClick="@{() -> listener.onDeleteButtonClicked()}"
            android:text="@string/delete"
            android:visibility="@{viewState.deleteButtonVisibility}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/buttonCreate"
            app:layout_constraintWidth_max="320dp" />

        <Button
            android:id="@+id/buttonBluetoothVisibility"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:onClick="@{() -> visibilityListener.onVisibilityButtonClicked()}"
            android:text="@string/bluetooth_not_discoverable"
            android:visibility="@{visibilityViewState == null ? View.GONE : View.VISIBLE}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/buttonDelete"
            app:layout_constraintWidth_max="320dp" />

        <TextView
            android:id="@+id/textBluetoothVisibility"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/bluetooth_only_visible_to_paired_devices"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/buttonBluetoothVisibility"
            app:visibilityDuration="@{visibilityViewState}" />

        <ProgressBar
            android:id="@+id/progressCreate"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="@{viewState.progressCreateVisibility}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textBluetoothVisibility" />

        <TextView
            android:id="@+id/textStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="@{viewState.isCreateOrDeleteButtonEnabled}"
            android:maxLines="1"
            android:text="@string/name"
            android:visibility="@{viewState.statusVisibility}"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progressCreate" />

        <TextView
            android:id="@+id/textStatusColon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="@{viewState.isCreateOrDeleteButtonEnabled}"
            android:maxLines="1"
            android:text="@string/colon"
            android:visibility="@{viewState.statusVisibility}"
            app:layout_constraintStart_toEndOf="@+id/textStatusLabel"
            app:layout_constraintTop_toBottomOf="@+id/progressCreate" />

        <TextView
            android:id="@+id/textStatusValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:enabled="@{viewState.isCreateOrDeleteButtonEnabled}"
            android:maxLines="2"
            android:visibility="@{viewState.statusVisibility}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/textStatusColon"
            app:layout_constraintTop_toBottomOf="@+id/progressCreate"
            app:setRoomSate="@{viewState.targetState}"
            tools:text="@string/name_not_set" />

        <View
            android:id="@+id/separator"
            android:layout_width="0dp"
            android:layout_height="@dimen/separator_width"
            android:layout_margin="8dp"
            android:background="@color/foreground_color"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textStatusValue" />

        <Button
            android:id="@+id/buttonScanStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:enabled="@{viewState.scanButtonEnabled}"
            android:onClick="@{() -> listener.onStartScanButtonClicked()}"
            android:text="@string/scan"
            android:visibility="@{viewState.startScanButtonVisibility}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/separator"
            app:layout_constraintWidth_max="320dp" />

        <Button
            android:id="@+id/buttonScanCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:enabled="@{viewState.scanButtonEnabled}"
            android:onClick="@{() -> listener.onCancelScanButtonClicked()}"
            android:text="@string/cancel"
            android:visibility="@{viewState.cancelScanButtonVisibility}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/buttonScanStart"
            app:layout_constraintWidth_max="320dp" />

        <ProgressBar
            android:id="@+id/progressScan"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="@{viewState.scanProgressVisibility}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/buttonScanCancel" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listTargets"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:items="@{viewState.discoveredItems}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progressScan" />

        <TextView
            android:id="@+id/textWarningEmpty"
            style="@style/TextAppearance.AppCompat.Large"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progressScan"
            app:setScanSate="@{viewState.scanState}"
            tools:text="@string/search_no_results" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
